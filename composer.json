{
    "name": "lara-zeus/chaos",
    "homepage": "https://larazeus.com",
    "support": {
        "issues": "https://github.com/lara-zeus/chaos/issues",
        "source": "https://github.com/lara-zeus/chaos"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "php coder",
            "email": "info@larazeus.com",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^5.0",
        "lara-zeus/popover": "^3.0",
        "lara-zeus/tabler-icons-enum": "^2.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/phpinsights": "^2.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "LaraZeus\\Chaos\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pint": "vendor/bin/pint",
        "test:phpstan": "vendor/bin/phpstan analyse",
        "test:pest": "vendor/bin/pest",
        "test": [
            "@test:phpstan",
            "@test:pest"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "LaraZeus\\Chaos\\ChaosServiceProvider"
            ]
        }
    }
}
