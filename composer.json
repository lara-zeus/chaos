{
    "name": "lara-zeus/chaos",
    "homepage": "https://larazeus.com",
    "support": {
        "issues": "https://github.com/lara-zeus/chaos/issues",
        "source": "https://github.com/lara-zeus/chaos"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "php coder",
            "email": "info@larazeus.com",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^4.0",
        "lara-zeus/popover": "^2.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "filament/upgrade": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/phpinsights": "^2.8",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LaraZeus\\Chaos\\": "src"
        }
    },
    "scripts": {
        "pint": "vendor/bin/pint",
        "test:phpstan": "vendor/bin/phpstan analyse",
        "test": [
            "@test:phpstan"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "LaraZeus\\Chaos\\ChaosServiceProvider"
            ]
        }
    }
}
